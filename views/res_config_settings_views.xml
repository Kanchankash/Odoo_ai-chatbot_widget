<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_ai_chatbot_view" model="ir.ui.view">
        <field name="name">res.config.settings.ai_chatbot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Chatbot" string="AI Chatbot"
                     name="ai_chatbot_widget"
                     groups="base.group_system">

                    <!-- Provider -->
                    <block title="LLM Provider" name="ai_chatbot_provider_block">
                        <setting id="ai_chatbot_provider_setting" string="Provider"
                                 help="Choose between local OpenAI-compatible server or Groq cloud.">
                            <field name="ai_chatbot_provider" widget="radio"/>
                        </setting>
                    </block>

                    <!-- Local settings -->
                    <block title="Local Server" name="ai_chatbot_local_block"
                           invisible="ai_chatbot_provider != 'local'">
                        <setting id="ai_chatbot_local_url_setting" string="Base URL"
                                 help="OpenAI-compatible endpoint, e.g. http://192.168.0.162:8001/v1">
                            <field name="ai_chatbot_local_base_url"
                                   placeholder="http://192.168.0.162:8001/v1"/>
                        </setting>
                        <setting id="ai_chatbot_local_model_setting" string="Model Name">
                            <field name="ai_chatbot_local_model" placeholder="gemma4"/>
                        </setting>
                    </block>

                    <!-- Groq settings — shown for Groq-only OR Hybrid (local + Groq key) -->
                    <block title="Groq Cloud" name="ai_chatbot_groq_block">
                        <setting id="ai_chatbot_groq_key_setting" string="Groq API Key"
                                 help="Required for Groq mode. In Local mode, adding a key enables Hybrid mode: Groq handles intent/query building, local model handles chat.">
                            <field name="ai_chatbot_groq_api_key" widget="password"
                                   placeholder="gsk_..."/>
                        </setting>
                        <setting id="ai_chatbot_router_model_setting" string="Router Model"
                                 help="Used for intent classification (e.g. llama-3.1-8b-instant)">
                            <field name="ai_chatbot_router_model"
                                   placeholder="llama-3.1-8b-instant"/>
                        </setting>
                        <setting id="ai_chatbot_reasoner_model_setting" string="Reasoner Model"
                                 help="Used for data queries and final answers (e.g. llama-3.3-70b-versatile)">
                            <field name="ai_chatbot_reasoner_model"
                                   placeholder="llama-3.3-70b-versatile"/>
                        </setting>
                        <setting id="ai_chatbot_redact_pii_setting" string="Redact PII"
                                 help="Mask emails, phone numbers and card numbers before sending to Groq.">
                            <field name="ai_chatbot_redact_pii"/>
                        </setting>
                    </block>

                    <!-- Access control -->
                    <block title="Data Access" name="ai_chatbot_access_block">
                        <setting id="ai_chatbot_allowed_models_setting"
                                 string="Allowed Odoo Models"
                                 help="The AI may only query models in this list. Add sale.order, crm.lead, account.move, etc.">
                            <field name="ai_chatbot_allowed_model_ids"
                                   widget="many2many_tags"/>
                        </setting>
                    </block>

                    <!-- Limits -->
                    <block title="Limits" name="ai_chatbot_limits_block">
                        <setting id="ai_chatbot_max_rpm_setting"
                                 string="Max Requests / Min / User"
                                 help="Token-bucket rate limit per user. Default 20.">
                            <field name="ai_chatbot_max_rpm"/>
                        </setting>
                        <setting id="ai_chatbot_max_history_setting"
                                 string="Max History Messages to LLM"
                                 help="How many recent messages are included in the LLM context window. Default 12.">
                            <field name="ai_chatbot_max_history"/>
                        </setting>
                    </block>

                    <!-- Test connection -->
                    <block title="Diagnostics" name="ai_chatbot_diag_block">
                        <setting id="ai_chatbot_test_conn_setting"
                                 string="Test Connection"
                                 help="Pings the LLM and shows latency. Save settings first.">
                            <button name="action_test_llm_connection"
                                    string="Test Connection"
                                    type="object"
                                    class="btn btn-secondary"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>
</odoo>
