<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_chatbot_widget.MessageBubble">
        <div class="o_chatbot_msg" t-att-class="{
                'o_chatbot_msg--user': isUser,
                'o_chatbot_msg--assistant': isAssistant,
                'o_chatbot_msg--error': message.isError,
            }">

            <div class="o_chatbot_msg_avatar">
                <t t-if="isUser">
                    <i class="fa fa-user" aria-hidden="true"/>
                </t>
                <t t-else="">
                    <i class="fa fa-robot" aria-hidden="true"/>
                </t>
            </div>

            <div class="o_chatbot_msg_body">
                <t t-if="isStreaming and !message.content">
                    <!-- Typing indicator -->
                    <span class="o_chatbot_typing_caret">▌</span>
                </t>
                <t t-else="">
                    <div class="o_chatbot_msg_content" t-out="renderedContent"/>
                    <t t-if="isStreaming">
                        <span class="o_chatbot_typing_caret">▌</span>
                    </t>
                </t>

                <!-- Chart -->
                <t t-if="chartSpec">
                    <ChartRenderer config="chartSpec"/>
                </t>

                <!-- CSV download button (shown when table data is available) -->
                <t t-if="hasTableData">
                    <div class="o_chatbot_msg_actions">
                        <button class="o_chatbot_export_btn" t-on-click="exportCSV" title="Download as CSV">
                            <i class="fa fa-download" aria-hidden="true"/> CSV
                        </button>
                    </div>
                </t>

                <!-- Follow-up suggestion chips -->
                <t t-if="hasSuggestions">
                    <div class="o_chatbot_suggestions">
                        <t t-foreach="message.suggestions" t-as="chip" t-key="chip_index">
                            <button class="o_chatbot_chip" t-on-click="() => this.sendSuggestion(chip)">
                                <t t-esc="chip"/>
                            </button>
                        </t>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
