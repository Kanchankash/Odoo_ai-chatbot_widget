<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_chatbot_widget.FloatingIcon">
        <!-- Only show the FAB when the window is closed -->
        <t t-if="!state.isOpen">
            <button class="o_chatbot_fab" t-on-click="onClick" title="Open AI Assistant"
                    aria-label="Open AI Assistant">
                <i class="fa fa-comments" aria-hidden="true"/>
                <t t-if="state.hasUnread">
                    <span class="o_chatbot_fab_badge"/>
                </t>
            </button>
        </t>
    </t>
</templates>
